{
	"$schema": "../gen/schemas/desktop-schema.json",
	"identifier": "report",
	"description": "Capability for the report webviews (report-basic / report-relationships)",
	"windows": ["report-basic", "report-relationships"],
	"permissions": [
		"core:default",
		"core:webview:allow-print",
		"core:window:allow-close",
		"core:window:allow-show",
		"core:window:allow-set-focus"
	]
}
